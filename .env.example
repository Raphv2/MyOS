# MyOS - fichier .env du SERVEUR (ne jamais le committer).
# Emplacement recommandé : AU-DESSUS de public_html, ex. domains/raphaelgosset.fr/.env
# (l'ancien emplacement public_html/.env marche toujours).

# Base de données (mêmes clés que l'ancien site)
DB_HOST=localhost
DB_NAME=u000000000_file_explorer
DB_USER=u000000000_user
DB_PASS=

# Admin intégré : générer avec `npm run admin:password`, puis coller la ligne ici.
ADMIN_PASSWORD_HASH=

# Optionnel
# Préfixe de la colonne `path` (identique aux lignes déjà en base)
# PATH_PREFIX=domains/raphaelgosset.fr/public_html/
# Taille max d'un fichier envoyé depuis l'admin (Mo), plafonnée par la config PHP
# UPLOAD_MAX_MB=512
# Dossiers qu'on ne peut ni supprimer ni déplacer depuis l'admin (C:, Users, Raphaël Gosset, Desktop)
# PROTECTED_FOLDER_IDS=1,2,3,8
# Dossier privé (sessions, anti-bruteforce, logs). Par défaut : à côté de public_html.
# STORAGE_DIR=/home/u000000000/domains/raphaelgosset.fr/myos-storage
